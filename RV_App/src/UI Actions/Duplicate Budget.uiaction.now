<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sys_ui_action">
    <sys_ui_action action="INSERT_OR_UPDATE">
        <sys_id>duplicate_budget_action_sys_id</sys_id>
        <name>Duplicate Budget</name>
        <table>x_467210_household_budget</table>
        <action_name>duplicate_budget</action_name>
        <client>true</client>
        <form_button>true</form_button>
        <form_context>form</form_context>
        <form_style>primary</form_style>
        <script>
            // Client script
            if (confirm('Duplicate this budget?')) {
                var ga = new GlideAjax('BudgetCalculator');
                ga.addParam('sysparm_name', 'duplicateBudget');
                ga.addParam('sysparm_original', g_form.getUniqueValue());
                ga.getXMLAnswer(function(response) {
                    var newId = response;
                    if (newId) {
                        gs.addInfoMessage('Budget duplicated. New ID: ' + newId);
                        // Redirect to new form
                        window.location = 'x_467210_household_budget.do?sys_id=' + newId;
                    }
                });
            }
        </script>
        <active>true</active>
        <sys_scope>x_467210_rv_app</sys_scope>
    </sys_ui_action>
</record_update></content>

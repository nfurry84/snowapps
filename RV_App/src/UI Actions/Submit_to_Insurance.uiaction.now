<?xml version="1.0" encoding="UTF-8"?>
<ui_action>
  <name>Submit to Insurance</name>
  <label>Submit to Insurance</label>
  <table>x_467210_rv_app_glass_claim</table>
  <condition>glass_claim_status=validated</condition>
  <hover_text>Submit this claim to the insurance provider for approval</hover_text>
  <order>100</order>
  <script>
    (function() {
      try {
        var claimGR = new GlideRecord('x_467210_rv_app_glass_claim');
        claimGR.get(current.sys_id);
        
        // Validate claim has all required information
        if (!claimGR.contact_email || !claimGR.insurance_provider || !claimGR.policy_number) {
          gs.warn('Cannot submit - missing required information');
          return false;
        }
        
        // Update status
        claimGR.approval_status = 'pending';
        claimGR.comments = claimGR.comments + '\nClaim submitted to insurance provider: ' + new GlideDateTime();
        claimGR.update();
        
        // Create notification task
        var taskGR = new GlideRecord('task');
        taskGR.initialize();
        taskGR.short_description = 'Submit RV Glass Claim to Insurance: ' + claimGR.contact_name;
        taskGR.description = 'Submit claim ' + claimGR.number + ' to ' + claimGR.insurance_provider.getDisplayValue();
        taskGR.assignment_group = gs.getUserID();
        taskGR.priority = '2';
        taskGR.insert();
        
        gs.addInfoMessage('Claim submitted to insurance provider');
      } catch (e) {
        gs.error('Error submitting claim: ' + e.message);
      }
    })();
  </script>
</ui_action>

<?xml version="1.0" encoding="UTF-8"?>
<record_update table="item_option_new">
    <item_option_new action="INSERT_OR_UPDATE">
        <sys_id>budget_name_var_sys_id</sys_id>
        <cat_item>budget_wizard_rp_sys_id</cat_item>
        <name>budget_name</name>
        <type>1</type> <!-- string -->
        <order>1</order>
        <mandatory>true</mandatory>
        <question>Budget Name</question>
    </item_option_new>
</record_update>
<record_update table="item_option_new">
    <item_option_new action="INSERT_OR_UPDATE">
        <sys_id>incomes_var_sys_id</sys_id>
        <cat_item>budget_wizard_rp_sys_id</cat_item>
        <name>incomes</name>
        <type>5</type> <!-- multi-line text -->
        <order>2</order>
        <question>Incomes (JSON format: [{"name":"Salary","amount":5000,"frequency":"monthly","start_date":"2023-01-01"}])</question>
    </item_option_new>
</record_update>
<record_update table="item_option_new">
    <item_option_new action="INSERT_OR_UPDATE">
        <sys_id>expenses_var_sys_id</sys_id>
        <cat_item>budget_wizard_rp_sys_id</cat_item>
        <name>expenses</name>
        <type>5</type>
        <order>3</order>
        <question>Expenses (JSON format: [{"name":"Rent","amount":1500,"frequency":"monthly","category":"housing","start_date":"2023-01-01"}])</question>
    </item_option_new>
</record_update>
<record_update table="item_option_new">
    <item_option_new action="INSERT_OR_UPDATE">
        <sys_id>subscriptions_var_sys_id</sys_id>
        <cat_item>budget_wizard_rp_sys_id</cat_item>
        <name>subscriptions</name>
        <type>5</type>
        <order>4</order>
        <question>Subscriptions (JSON format: [{"name":"Netflix","amount":15,"frequency":"monthly","category":"entertainment","start_date":"2023-01-01","auto_renew":true,"renewal_date":"2023-02-01"}])</question>
    </item_option_new>
</record_update></content>

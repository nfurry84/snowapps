/**
 * GlassClaimProcessor
 * Handles glass claim validation, calculation, and processing
 */
var GlassClaimProcessor = Class.create();

GlassClaimProcessor.prototype = {
    initialize: function() {
        this.claimTable = 'x_467210_rv_app_glass_claim';
        this.shopTable = 'x_467210_rv_app_glass_shop';
    },
    
    /**
     * Process new claim submission
     */
    processClaim: function(claimGR) {
        try {
            if (!this.validateClaim(claimGR)) {
                return false;
            }
            
            // Set initial status
            claimGR.glass_claim_status = 'validated';
            claimGR.approval_status = 'pending';
            
            // Calculate deductible and coverage
            this.calculateCoverage(claimGR);
            
            // Find nearby repair shops
            var shops = this.findNearbyShops(claimGR);
            
            if (shops.length > 0) {
                // Assign the best rated shop
                var bestShop = this.selectBestShop(shops, claimGR);
                this.assignShop(claimGR, bestShop);
                claimGR.glass_claim_status = 'shop_assigned';
            }
            
            claimGR.update();
            
            // Create notification task
            this.createNotificationTask(claimGR);
            
            return true;
        } catch (e) {
            gs.error('Error in GlassClaimProcessor.processClaim: ' + e.message);
            return false;
        }
    },
    
    /**
     * Validate claim data
     */
    validateClaim: function(claimGR) {
        var errors = [];
        
        // Contact validation
        if (!claimGR.contact_name || claimGR.contact_name.trim() === '') {
            errors.push('Contact name is required');
        }
        
        if (!this.isValidEmail(claimGR.contact_email)) {
            errors.push('Valid email is required');
        }
        
        if (!this.isValidPhone(claimGR.contact_phone)) {
            errors.push('Valid phone number is required');
        }
        
        // Vehicle validation
        if (!claimGR.vehicle_year || claimGR.vehicle_year < 1950) {
            errors.push('Valid vehicle year is required');
        }
        
        if (!claimGR.vehicle_make || claimGR.vehicle_make.trim() === '') {
            errors.push('Vehicle make is required');
        }
        
        // Insurance validation
        if (!claimGR.insurance_provider) {
            errors.push('Insurance provider is required');
        }
        
        if (!claimGR.policy_number || claimGR.policy_number.trim() === '') {
            errors.push('Policy number is required');
        }
        
        if (errors.length > 0) {
            claimGR.comments = 'Validation errors: ' + errors.join('; ');
            return false;
        }
        
        return true;
    },
    
    /**
     * Calculate insurance coverage and customer responsibility
     */
    calculateCoverage: function(claimGR) {
        try {
            var estimatedCost = claimGR.estimated_cost || 0;
            var deductible = claimGR.deductible_amount || 0;
            
            // Insurance typically covers 100% after deductible
            var insuranceCovers = Math.max(0, estimatedCost - deductible);
            var customerResponsibility = Math.min(estimatedCost, deductible);
            
            claimGR.insurance_covers = insuranceCovers;
            claimGR.customer_responsibility = customerResponsibility;
            
            return true;
        } catch (e) {
            gs.error('Error calculating coverage: ' + e.message);
            return false;
        }
    },
    
    /**
     * Find nearby repair shops
     */
    findNearbyShops: function(claimGR) {
        var shops = [];
        var query = 'active=true^accepts_insurance=true';
        
        var shopGR = new GlideRecord(this.shopTable);
        shopGR.addQuery(query);
        shopGR.query();
        
        while (shopGR.next()) {
            var distance = this.calculateDistance(
                claimGR.getValue('service_address'),
                shopGR.getValue('address')
            );
            
            // Only include shops within 50 miles
            if (distance < 50) {
                shops.push({
                    sysId: shopGR.getValue('sys_id'),
                    name: shopGR.getValue('shop_name'),
                    distance: distance,
                    rating: shopGR.getValue('rating'),
                    phone: shopGR.getValue('phone'),
                    address: shopGR.getValue('address'),
                    city: shopGR.getValue('city'),
                    latitude: shopGR.getValue('latitude'),
                    longitude: shopGR.getValue('longitude')
                });
            }
        }
        
        return shops;
    },
    
    /**
     * Select best shop based on rating and distance
     */
    selectBestShop: function(shops, claimGR) {
        if (shops.length === 0) return null;
        
        // Score shops: 50% rating, 50% inverse of distance
        var scored = shops.map(function(shop) {
            var ratingScore = (shop.rating || 0) / 5; // 0-1
            var distanceScore = Math.max(0, 1 - (shop.distance / 50)); // 0-1
            var score = (ratingScore * 0.5) + (distanceScore * 0.5);
            
            shop.score = score;
            return shop;
        });
        
        scored.sort(function(a, b) {
            return b.score - a.score;
        });
        
        return scored[0];
    },
    
    /**
     * Assign shop to claim
     */
    assignShop: function(claimGR, shop) {
        if (!shop) return false;
        
        claimGR.assigned_shop = shop.sysId;
        claimGR.shop_contact_name = shop.name;
        claimGR.shop_phone = shop.phone;
        claimGR.shop_address = shop.address;
        claimGR.shop_latitude = shop.latitude;
        claimGR.shop_longitude = shop.longitude;
        
        return true;
    },
    
    /**
     * Helper: Calculate distance between two addresses (simple approximation)
     * In production, use Google Maps API
     */
    calculateDistance: function(address1, address2) {
        // This is a simplified version
        // In production, integrate with Google Maps API or use haversine formula
        return Math.random() * 40; // Placeholder
    },
    
    /**
     * Helper: Validate email format
     */
    isValidEmail: function(email) {
        var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        return emailRegex.test(email);
    },
    
    /**
     * Helper: Validate phone format
     */
    isValidPhone: function(phone) {
        var phoneRegex = /^[\d\s\-\+\(\)]{10,}$/;
        return phoneRegex.test(phone);
    },
    
    /**
     * Create notification task for claim processing
     */
    createNotificationTask: function(claimGR) {
        try {
            var notifGR = new GlideRecord('task');
            notifGR.initialize();
            notifGR.short_description = 'RV Glass Claim Processing: ' + claimGR.getValue('contact_name');
            notifGR.description = 'Claim ' + claimGR.getValue('number') + ' requires insurance approval and scheduling';
            notifGR.assigned_to = gs.getUserID();
            notifGR.priority = '3';
            notifGR.insert();
            
            return true;
        } catch (e) {
            gs.error('Error creating notification task: ' + e.message);
            return false;
        }
    },
    
    type: 'GlassClaimProcessor'
};

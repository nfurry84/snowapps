/**
 * GoogleMapsIntegration
 * Handles integration with Google Maps API for shop location searching
 * Note: API calls disabled in PDI environment for security
 */
var GoogleMapsIntegration = Class.create();

GoogleMapsIntegration.prototype = {
    initialize: function() {
        this.shopTable = 'x_467210_rv_app_glass_shop';
        this.apiKey = gs.getProperty('x_467210_rv_app.google_maps_api_key', '');
        this.baseUrl = 'https://maps.googleapis.com/maps/api';
        this.isEnabled = gs.getProperty('x_467210_rv_app.google_maps_enabled', 'false') === 'true';
    },
    
    /**
     * Search for glass repair shops near a location
     */
    searchNearbyShops: function(latitude, longitude, radius) {
        if (!this.isEnabled) {
            gs.info('Google Maps API is disabled in this environment');
            return this.getMockShops(latitude, longitude);
        }
        
        try {
            var endpoint = this.baseUrl + '/place/nearbysearch/json';
            var params = {
                location: latitude + ',' + longitude,
                radius: radius * 1609.34, // Convert miles to meters
                type: 'car_repair',
                keyword: 'glass repair RV',
                key: this.apiKey
            };
            
            var response = this.makeHttpRequest(endpoint, params);
            
            if (response && response.results) {
                return this.processSearchResults(response.results, latitude, longitude);
            }
            
            return [];
        } catch (e) {
            gs.error('Error searching nearby shops: ' + e.message);
            return [];
        }
    },
    
    /**
     * Get place details from Google Maps
     */
    getPlaceDetails: function(placeId) {
        if (!this.isEnabled) {
            return this.getMockPlaceDetails(placeId);
        }
        
        try {
            var endpoint = this.baseUrl + '/place/details/json';
            var params = {
                place_id: placeId,
                fields: 'formatted_address,formatted_phone_number,website,opening_hours,rating,reviews,user_ratings_total',
                key: this.apiKey
            };
            
            var response = this.makeHttpRequest(endpoint, params);
            
            if (response && response.result) {
                return response.result;
            }
            
            return null;
        } catch (e) {
            gs.error('Error getting place details: ' + e.message);
            return null;
        }
    },
    
    /**
     * Calculate distance between two coordinates using Haversine formula
     */
    calculateDistance: function(lat1, lon1, lat2, lon2) {
        var R = 3959; // Earth radius in miles
        var dLat = this.toRad(lat2 - lat1);
        var dLon = this.toRad(lon2 - lon1);
        
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(this.toRad(lat1)) * Math.cos(this.toRad(lat2)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
        
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        var distance = R * c;
        
        return parseFloat(distance.toFixed(2));
    },
    
    /**
     * Sync shops from Google Maps to local database
     */
    syncShopsFromGoogle: function(latitude, longitude, radius) {
        if (!this.isEnabled) {
            gs.info('Google Maps sync disabled, using mock data');
            return this.syncMockShops(latitude, longitude);
        }
        
        try {
            var shops = this.searchNearbyShops(latitude, longitude, radius);
            var syncedCount = 0;
            
            for (var i = 0; i < shops.length; i++) {
                if (this.upsertShop(shops[i])) {
                    syncedCount++;
                }
            }
            
            gs.info('Synced ' + syncedCount + ' shops from Google Maps');
            return syncedCount;
        } catch (e) {
            gs.error('Error syncing shops: ' + e.message);
            return 0;
        }
    },
    
    /**
     * Insert or update shop in database
     */
    upsertShop: function(shopData) {
        try {
            var shopGR = new GlideRecord(this.shopTable);
            shopGR.addQuery('google_place_id', shopData.place_id);
            shopGR.query();
            
            if (shopGR.next()) {
                // Update existing
                shopGR.shop_name = shopData.name;
                shopGR.address = shopData.address;
                shopGR.latitude = shopData.latitude;
                shopGR.longitude = shopData.longitude;
                shopGR.phone = shopData.phone;
                shopGR.website = shopData.website || '';
                shopGR.rating = shopData.rating || 0;
                shopGR.review_count = shopData.review_count || 0;
                shopGR.last_synced = new GlideDateTime();
                shopGR.update();
            } else {
                // Insert new
                shopGR.initialize();
                shopGR.shop_name = shopData.name;
                shopGR.address = shopData.address;
                shopGR.city = shopData.city;
                shopGR.state = shopData.state;
                shopGR.latitude = shopData.latitude;
                shopGR.longitude = shopData.longitude;
                shopGR.phone = shopData.phone;
                shopGR.website = shopData.website || '';
                shopGR.email = shopData.email || '';
                shopGR.google_place_id = shopData.place_id;
                shopGR.rating = shopData.rating || 0;
                shopGR.review_count = shopData.review_count || 0;
                shopGR.accepts_insurance = true;
                shopGR.shop_type = 'fixed_location';
                shopGR.services_offered = 'glass repair, glass replacement';
                shopGR.last_synced = new GlideDateTime();
                shopGR.insert();
            }
            
            return true;
        } catch (e) {
            gs.error('Error upserting shop: ' + e.message);
            return false;
        }
    },
    
    /**
     * Make HTTP request to external API
     */
    makeHttpRequest: function(endpoint, params) {
        try {
            var request = new XMLHttpRequest();
            var queryString = this.buildQueryString(params);
            var url = endpoint + '?' + queryString;
            
            request.open('GET', url, false);
            request.send();
            
            if (request.status === 200) {
                return JSON.parse(request.responseText);
            }
            
            return null;
        } catch (e) {
            gs.error('HTTP request failed: ' + e.message);
            return null;
        }
    },
    
    /**
     * Build query string from parameters
     */
    buildQueryString: function(params) {
        var parts = [];
        for (var key in params) {
            if (params.hasOwnProperty(key)) {
                parts.push(encodeURIComponent(key) + '=' + encodeURIComponent(params[key]));
            }
        }
        return parts.join('&');
    },
    
    /**
     * Process Google Maps search results
     */
    processSearchResults: function(results, refLat, refLon) {
        var shops = [];
        
        for (var i = 0; i < results.length && i < 10; i++) {
            var result = results[i];
            var distance = this.calculateDistance(
                refLat,
                refLon,
                result.geometry.location.lat,
                result.geometry.location.lng
            );
            
            shops.push({
                place_id: result.place_id,
                name: result.name,
                address: result.vicinity,
                city: this.extractCity(result.vicinity),
                state: this.extractState(result.vicinity),
                latitude: result.geometry.location.lat,
                longitude: result.geometry.location.lng,
                phone: result.formatted_phone_number || '',
                website: result.website || '',
                email: result.email || '',
                rating: result.rating || 0,
                review_count: result.user_ratings_total || 0,
                distance: distance
            });
        }
        
        return shops;
    },
    
    /**
     * Mock shops for PDI testing (disabled API)
     */
    getMockShops: function(latitude, longitude) {
        return [
            {
                place_id: 'mock_001',
                name: 'Sunshine Glass Works',
                address: '123 Main St, Phoenix, AZ 85001',
                city: 'Phoenix',
                state: 'AZ',
                latitude: latitude + 0.01,
                longitude: longitude + 0.01,
                phone: '(602) 555-0101',
                website: 'www.sunshineglass.com',
                rating: 4.8,
                review_count: 142,
                distance: 2.5
            },
            {
                place_id: 'mock_002',
                name: 'Desert Auto Glass',
                address: '456 Oak Ave, Phoenix, AZ 85002',
                city: 'Phoenix',
                state: 'AZ',
                latitude: latitude - 0.01,
                longitude: longitude - 0.01,
                phone: '(602) 555-0102',
                website: 'www.desertautoglass.com',
                rating: 4.5,
                review_count: 98,
                distance: 3.2
            },
            {
                place_id: 'mock_003',
                name: 'Quick Glass Mobile Service',
                address: '789 Pine Rd, Phoenix, AZ 85003',
                city: 'Phoenix',
                state: 'AZ',
                latitude: latitude + 0.02,
                longitude: longitude - 0.02,
                phone: '(602) 555-0103',
                website: 'www.quickglassmobile.com',
                rating: 4.6,
                review_count: 156,
                distance: 4.1
            }
        ];
    },
    
    /**
     * Mock place details
     */
    getMockPlaceDetails: function(placeId) {
        return {
            formatted_phone_number: '(602) 555-0101',
            website: 'www.sunshineglass.com',
            opening_hours: {
                weekday_text: [
                    'Monday: 7:00 AM - 6:00 PM',
                    'Tuesday: 7:00 AM - 6:00 PM',
                    'Wednesday: 7:00 AM - 6:00 PM',
                    'Thursday: 7:00 AM - 6:00 PM',
                    'Friday: 7:00 AM - 6:00 PM',
                    'Saturday: 8:00 AM - 4:00 PM',
                    'Sunday: Closed'
                ]
            },
            rating: 4.8,
            user_ratings_total: 142
        };
    },
    
    /**
     * Sync mock shops to database
     */
    syncMockShops: function(latitude, longitude) {
        var shops = this.getMockShops(latitude, longitude);
        var count = 0;
        
        for (var i = 0; i < shops.length; i++) {
            if (this.upsertShop(shops[i])) {
                count++;
            }
        }
        
        return count;
    },
    
    /**
     * Helper: Extract city from address
     */
    extractCity: function(address) {
        var parts = address.split(',');
        return parts.length > 1 ? parts[parts.length - 2].trim() : '';
    },
    
    /**
     * Helper: Extract state from address
     */
    extractState: function(address) {
        var match = address.match(/([A-Z]{2})\s*\d{5}/);
        return match ? match[1] : '';
    },
    
    /**
     * Helper: Convert degrees to radians
     */
    toRad: function(degrees) {
        return degrees * (Math.PI / 180);
    },
    
    type: 'GoogleMapsIntegration'
};

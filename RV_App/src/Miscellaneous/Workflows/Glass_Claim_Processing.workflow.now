<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>RV Glass Claim Processing Workflow</name>
  <description>Main workflow for processing RV glass insurance claims from intake to completion</description>
  <table>x_467210_rv_app_glass_claim</table>
  <initial_stage>validate_claim</initial_stage>
  <publish>true</publish>
  
  <stages>
    <stage>
      <name>validate_claim</name>
      <label>Validate Claim</label>
      <description>Validate all required claim information</description>
      <transitions>
        <transition target="find_shops" condition="validation_passed">Proceed to Shop Search</transition>
        <transition target="claim_denied" condition="validation_failed">Deny Claim</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>find_shops</name>
      <label>Find Nearby Repair Shops</label>
      <description>Search for nearby repair shops using Google Maps</description>
      <activity>
        <type>script_activity</type>
        <script>
          var gmaps = new GoogleMapsIntegration();
          
          // Get claim location from address
          var claimAddress = current.getValue('contact_address');
          var latitude = 33.7490; // Example Phoenix coordinates
          var longitude = -112.0808;
          
          // Find shops within 50 miles
          var shopCount = gmaps.syncShopsFromGoogle(latitude, longitude, 50);
          
          gs.info('Found ' + shopCount + ' nearby repair shops for claim ' + current.getValue('number'));
          
          current.glass_claim_status = 'shop_assigned';
          current.update();
        </script>
      </activity>
      <transitions>
        <transition target="assign_shop">Shops Found</transition>
        <transition target="no_shops_available">No Shops Available</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>assign_shop</name>
      <label>Assign Repair Shop</label>
      <description>Automatically assign the best available repair shop</description>
      <activity>
        <type>script_activity</type>
        <script>
          var processor = new GlassClaimProcessor();
          var shops = processor.findNearbyShops(current);
          
          if (shops.length > 0) {
              var bestShop = processor.selectBestShop(shops, current);
              processor.assignShop(current, bestShop);
              current.update();
              gs.info('Assigned shop: ' + bestShop.name);
          }
        </script>
      </activity>
      <transitions>
        <transition target="process_payment">Shop Assigned</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>process_payment</name>
      <label>Process Deductible Payment</label>
      <description>Process payment for deductible (DISABLED IN PDI)</description>
      <activity>
        <type>script_activity</type>
        <script>
          var paymentProcessor = new PaymentProcessor();
          var paymentResult = paymentProcessor.processDeductiblePayment(current);
          
          if (paymentResult) {
              gs.info('Payment processed for claim: ' + current.getValue('number'));
          } else {
              gs.warn('Payment processing failed or skipped in PDI');
          }
        </script>
      </activity>
      <transitions>
        <transition target="schedule_service">Payment Processed</transition>
        <transition target="payment_failed">Payment Failed</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>schedule_service</name>
      <label>Schedule Service</label>
      <description>Contact repair shop and schedule service appointment</description>
      <activity>
        <type>notification</type>
        <recipients>
          <recipient type="reference">assigned_shop</recipient>
        </recipients>
        <subject>New RV Glass Claim Assignment - {short_description}</subject>
        <template>rv_glass_claim_shop_notification</template>
      </activity>
      <transitions>
        <transition target="service_in_progress">Service Scheduled</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>service_in_progress</name>
      <label>Service In Progress</label>
      <description>Service is being performed at repair shop</description>
      <transitions>
        <transition target="claim_completed">Service Complete</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>claim_completed</name>
      <label>Claim Completed</label>
      <description>Service completed, claim is closed</description>
      <activity>
        <type>notification</type>
        <recipients>
          <recipient type="user">contact_name</recipient>
        </recipients>
        <subject>Your RV Glass Claim is Complete - {short_description}</subject>
        <template>rv_glass_claim_completion_notification</template>
      </activity>
      <final>true</final>
    </stage>
    
    <stage>
      <name>no_shops_available</name>
      <label>No Shops Available</label>
      <description>No repair shops found in service area</description>
      <activity>
        <type>notification</type>
        <recipients>
          <recipient type="user">contact_name</recipient>
        </recipients>
        <subject>RV Glass Claim - Manual Shop Selection Required</subject>
        <template>rv_glass_claim_manual_shop_notification</template>
      </activity>
      <transitions>
        <transition target="manual_shop_selection">Awaiting Manual Shop Selection</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>manual_shop_selection</name>
      <label>Manual Shop Selection</label>
      <description>Waiting for customer or support to select a shop</description>
      <transitions>
        <transition target="process_payment">Shop Selected</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>payment_failed</name>
      <label>Payment Failed</label>
      <description>Payment processing failed - retry or use alternate method</description>
      <activity>
        <type>notification</type>
        <recipients>
          <recipient type="user">contact_name</recipient>
        </recipients>
        <subject>RV Glass Claim - Payment Issue</subject>
        <template>rv_glass_claim_payment_failed_notification</template>
      </activity>
      <transitions>
        <transition target="process_payment">Retry Payment</transition>
        <transition target="claim_denied">Decline Claim</transition>
      </transitions>
    </stage>
    
    <stage>
      <name>claim_denied</name>
      <label>Claim Denied</label>
      <description>Claim has been denied</description>
      <activity>
        <type>notification</type>
        <recipients>
          <recipient type="user">contact_name</recipient>
        </recipients>
        <subject>RV Glass Claim Denied</subject>
        <template>rv_glass_claim_denied_notification</template>
      </activity>
      <final>true</final>
    </stage>
  </stages>
  
</workflow>

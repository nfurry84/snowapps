<?xml version="1.0" encoding="UTF-8"?>
<business_rule>
  <name>Glass Claim - Calculate Insurance Coverage</name>
  <table>x_467210_rv_app_glass_claim</table>
  <when>before_update,before_insert</when>
  <priority>100</priority>
  <description>Automatically calculates insurance coverage and customer responsibility based on deductible</description>
  <script>
    (function() {
        // Only calculate if estimated cost and deductible are present
        if (!current.estimated_cost || !current.deductible_amount) {
            return;
        }
        
        var estimatedCost = parseFloat(current.estimated_cost);
        var deductible = parseFloat(current.deductible_amount);
        
        // Insurance covers cost minus deductible
        var insuranceCovers = Math.max(0, estimatedCost - deductible);
        var customerResponsibility = Math.min(estimatedCost, deductible);
        
        current.insurance_covers = insuranceCovers;
        current.customer_responsibility = customerResponsibility;
        
        gs.info('Coverage calculated - Insurance: $' + insuranceCovers.toFixed(2) + 
                ', Customer: $' + customerResponsibility.toFixed(2));
    })();
  </script>
</business_rule>

/**
 * PaymentProcessor
 * Handles payment processing for claim deductibles
 * DISABLED IN PDI - No actual charges are processed
 */
var PaymentProcessor = Class.create();

PaymentProcessor.prototype = {
    initialize: function() {
        this.claimTable = 'x_467210_rv_app_glass_claim';
        this.isPDI = gs.getProperty('x_467210_rv_app.is_pdi_instance', 'true') === 'true';
        this.processPayments = gs.getProperty('x_467210_rv_app.process_real_payments', 'false') === 'true';
    },
    
    /**
     * Process deductible payment
     * Returns false if PDI or payment processing disabled
     */
    processDeductiblePayment: function(claimGR) {
        if (this.isPDI && !this.processPayments) {
            gs.info('Payment processing disabled in PDI environment for claim: ' + claimGR.getValue('number'));
            claimGR.comments += '\n[PDI] Deductible payment skipped - Testing environment';
            return true; // Return true to continue workflow, but no actual charge
        }
        
        try {
            var paymentMethod = claimGR.getValue('payment_method');
            var deductibleAmount = parseFloat(claimGR.getValue('customer_responsibility'));
            
            if (deductibleAmount <= 0) {
                gs.info('No payment required for claim: ' + claimGR.getValue('number'));
                return true;
            }
            
            if (paymentMethod === 'credit_card' || paymentMethod === 'debit_card') {
                return this.processCardPayment(claimGR, deductibleAmount, paymentMethod);
            } else if (paymentMethod === 'invoice') {
                return this.createInvoice(claimGR, deductibleAmount);
            }
            
            return false;
        } catch (e) {
            gs.error('Error in PaymentProcessor.processDeductiblePayment: ' + e.message);
            return false;
        }
    },
    
    /**
     * Process card payment (DISABLED IN PDI)
     */
    processCardPayment: function(claimGR, amount, cardType) {
        if (this.isPDI && !this.processPayments) {
            gs.warn('Card payment processing DISABLED in PDI - No actual charge');
            this.maskCardData(claimGR);
            return true;
        }
        
        try {
            // In production, integrate with payment gateway
            // Stripe, Square, PayPal, etc.
            var paymentGateway = gs.getProperty('x_467210_rv_app.payment_gateway', 'stripe');
            
            var token = this.tokenizeCard(claimGR);
            if (!token) {
                gs.error('Failed to tokenize card');
                return false;
            }
            
            var result = this.chargeCard(token, amount, paymentGateway);
            
            if (result.success) {
                claimGR.comments += '\nPayment processed: $' + amount + ' charged';
                return true;
            } else {
                claimGR.comments += '\nPayment failed: ' + result.error;
                return false;
            }
        } catch (e) {
            gs.error('Error processing card payment: ' + e.message);
            return false;
        }
    },
    
    /**
     * Create invoice for deductible
     */
    createInvoice: function(claimGR, amount) {
        try {
            var invoiceGR = new GlideRecord('change_request');
            invoiceGR.initialize();
            invoiceGR.short_description = 'RV Glass Claim Deductible Invoice: ' + claimGR.getValue('contact_name');
            invoiceGR.description = 'Deductible amount: $' + amount.toFixed(2) + 
                                   '\nPolicy: ' + claimGR.getValue('policy_number') +
                                   '\nClaim: ' + claimGR.getValue('number');
            invoiceGR.assignment_group = this.getAccountsReceivableGroup();
            invoiceGR.priority = '3';
            invoiceGR.insert();
            
            claimGR.comments += '\nInvoice created for deductible payment';
            return true;
        } catch (e) {
            gs.error('Error creating invoice: ' + e.message);
            return false;
        }
    },
    
    /**
     * Tokenize card for secure processing
     * MOCK IMPLEMENTATION - Never stores real card data
     */
    tokenizeCard: function(claimGR) {
        if (this.isPDI && !this.processPayments) {
            return 'mock_token_pdi_' + Math.random().toString(36).substr(2, 9);
        }
        
        try {
            // In production, use payment gateway tokenization
            // This ensures PCI compliance
            var cardLastFour = claimGR.getValue('card_last_four');
            var token = 'tok_' + cardLastFour + '_' + Date.now();
            
            return token;
        } catch (e) {
            gs.error('Error tokenizing card: ' + e.message);
            return null;
        }
    },
    
    /**
     * Charge card using payment gateway
     * DISABLED IN PDI
     */
    chargeCard: function(token, amount, gateway) {
        if (this.isPDI && !this.processPayments) {
            return {
                success: true,
                transactionId: 'PDI_TEST_' + Math.random().toString(36).substr(2, 9),
                message: 'PDI Test Mode - No actual charge'
            };
        }
        
        try {
            // Production payment gateway integration
            var endpoint = this.getPaymentGatewayEndpoint(gateway);
            
            var payload = {
                token: token,
                amount: Math.round(amount * 100), // Convert to cents
                currency: 'USD',
                description: 'RV Glass Claim Deductible'
            };
            
            var response = this.makePaymentRequest(endpoint, payload);
            
            return response;
        } catch (e) {
            gs.error('Error charging card: ' + e.message);
            return {
                success: false,
                error: e.message
            };
        }
    },
    
    /**
     * Mask sensitive card data
     */
    maskCardData: function(claimGR) {
        var cardLastFour = claimGR.getValue('card_last_four');
        var masked = '****-****-****-' + cardLastFour;
        claimGR.card_encrypted = masked;
    },
    
    /**
     * Validate card data format
     */
    validateCardData: function(cardNumber, expiryDate, cvv) {
        // Validate card number using Luhn algorithm
        if (!this.validateCardNumber(cardNumber)) {
            return false;
        }
        
        // Validate expiry date
        if (!this.validateExpiryDate(expiryDate)) {
            return false;
        }
        
        // Validate CVV
        if (!this.validateCVV(cvv)) {
            return false;
        }
        
        return true;
    },
    
    /**
     * Validate card number using Luhn algorithm
     */
    validateCardNumber: function(cardNumber) {
        var digits = cardNumber.replace(/\D/g, '');
        var sum = 0;
        var isEven = false;
        
        for (var i = digits.length - 1; i >= 0; i--) {
            var digit = parseInt(digits.charAt(i), 10);
            
            if (isEven) {
                digit *= 2;
                if (digit > 9) {
                    digit -= 9;
                }
            }
            
            sum += digit;
            isEven = !isEven;
        }
        
        return (sum % 10) === 0;
    },
    
    /**
     * Validate expiry date format (MM/YY)
     */
    validateExpiryDate: function(expiryDate) {
        var match = expiryDate.match(/^(\d{2})\/(\d{2})$/);
        if (!match) return false;
        
        var month = parseInt(match[1], 10);
        var year = parseInt(match[2], 10);
        
        if (month < 1 || month > 12) return false;
        
        var currentDate = new Date();
        var currentYear = currentDate.getFullYear() % 100;
        var currentMonth = currentDate.getMonth() + 1;
        
        if (year < currentYear) return false;
        if (year === currentYear && month < currentMonth) return false;
        
        return true;
    },
    
    /**
     * Validate CVV format
     */
    validateCVV: function(cvv) {
        var cvvRegex = /^\d{3,4}$/;
        return cvvRegex.test(cvv);
    },
    
    /**
     * Get payment gateway endpoint
     */
    getPaymentGatewayEndpoint: function(gateway) {
        var endpoints = {
            stripe: 'https://api.stripe.com/v1/charges',
            square: 'https://connect.squareup.com/v2/payments',
            paypal: 'https://api.paypal.com/v1/payments/payment'
        };
        return endpoints[gateway] || endpoints.stripe;
    },
    
    /**
     * Make HTTP request to payment gateway
     */
    makePaymentRequest: function(endpoint, payload) {
        // Implementation would depend on specific payment gateway
        // This is a placeholder
        return {
            success: true,
            transactionId: 'txn_' + Date.now()
        };
    },
    
    /**
     * Get accounts receivable group
     */
    getAccountsReceivableGroup: function() {
        var groupGR = new GlideRecord('sys_user_group');
        groupGR.addQuery('name', 'Accounts Receivable');
        groupGR.query();
        
        if (groupGR.next()) {
            return groupGR.getValue('sys_id');
        }
        
        return null;
    },
    
    /**
     * Refund payment
     */
    refundPayment: function(claimGR, transactionId) {
        if (this.isPDI && !this.processPayments) {
            gs.info('Refund skipped in PDI environment');
            return true;
        }
        
        try {
            // Implementation depends on payment gateway
            gs.info('Refund requested for transaction: ' + transactionId);
            return true;
        } catch (e) {
            gs.error('Error processing refund: ' + e.message);
            return false;
        }
    },
    
    type: 'PaymentProcessor'
};

<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sys_script_include">
    <sys_script_include action="INSERT_OR_UPDATE">
        <sys_id>budget_calculator_si_sys_id</sys_id>
        <name>BudgetCalculator</name>
        <script>
            var BudgetCalculator = Class.create();
            BudgetCalculator.prototype = {
                calculateCashflow: function(budgetId) {
                    var totalIncome = 0, totalExpense = 0;
                    // Sum incomes
                    var incGR = new GlideRecord('x_467210_income_source');
                    incGR.addQuery('budget', budgetId);
                    incGR.query();
                    while (incGR.next()) {
                        totalIncome += parseFloat(incGR.amount);
                    }
                    // Sum expenses
                    var expGR = new GlideRecord('x_467210_expense');
                    expGR.addQuery('budget', budgetId);
                    expGR.query();
                    while (expGR.next()) {
                        totalExpense += parseFloat(expGR.amount);
                    }
                    // Sum subscriptions (as expenses)
                    var subGR = new GlideRecord('x_467210_subscription');
                    subGR.addQuery('budget', budgetId);
                    subGR.query();
                    while (subGR.next()) {
                        totalExpense += parseFloat(subGR.amount);
                    }
                    return totalIncome - totalExpense;
                },
                compareBudgets: function(budget1Id, budget2Id) {
                    var cf1 = this.calculateCashflow(budget1Id);
                    var cf2 = this.calculateCashflow(budget2Id);
                    var diff = cf1 - cf2;
                    return { delta: diff, description: 'Cashflow difference: $' + diff };
                },
                duplicateBudget: function(originalId) {
                    var orig = new GlideRecord('x_467210_household_budget');
                    if (orig.get(originalId)) {
                        var dup = new GlideRecord('x_467210_household_budget');
                        dup.budget_name = orig.budget_name + ' (Copy)';
                        dup.user = orig.user;
                        dup.status = 'draft';
                        dup.version = parseInt(orig.version) + 1;
                        dup.parent_budget = orig.sys_id;
                        var newId = dup.insert();
                        // Duplicate related records
                        this._duplicateRelated('x_467210_income_source', 'budget', originalId, newId);
                        this._duplicateRelated('x_467210_expense', 'budget', originalId, newId);
                        this._duplicateRelated('x_467210_subscription', 'budget', originalId, newId);
                        return newId;
                    }
                    return null;
                },
                _duplicateRelated: function(table, field, oldId, newId) {
                    var gr = new GlideRecord(table);
                    gr.addQuery(field, oldId);
                    gr.query();
                    while (gr.next()) {
                        var newRec = new GlideRecord(table);
                        newRec.setValue(field, newId);
                        for (var prop in gr) {
                            if (prop != 'sys_id' && prop != field) {
                                newRec.setValue(prop, gr[prop]);
                            }
                        }
                        newRec.insert();
                    }
                },
                type: 'BudgetCalculator'
            };
        </script>
        <active>true</active>
        <sys_scope>x_467210_rv_app</sys_scope>
    </sys_script_include>
</record_update></content>

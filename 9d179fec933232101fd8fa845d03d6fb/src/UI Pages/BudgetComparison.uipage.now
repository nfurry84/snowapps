<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <sys_id>budget_comparison_ui_sys_id</sys_id>
        <name>budget_comparison</name>
        <html>
            <![CDATA[
            <?xml version="1.0" encoding="utf-8" ?>
            <j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
                <html>
                <head>
                    <title>Budget Comparison</title>
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <style>
                        body { font-family: Arial, sans-serif; }
                        .comparison { display: flex; justify-content: space-around; }
                        .budget { width: 45%; }
                        canvas { max-width: 100%; }
                    </style>
                </head>
                <body>
                    <h1>Budget Comparison</h1>
                    <form>
                        <label>Budget 1:</label>
                        <g:ui_reference name="budget1" table="x_467210_household_budget" query="user=javascript:gs.getUserID()"/>
                        <label>Budget 2:</label>
                        <g:ui_reference name="budget2" table="x_467210_household_budget" query="user=javascript:gs.getUserID()"/>
                        <input type="button" value="Compare" onclick="compareBudgets()"/>
                    </form>
                    <div class="comparison">
                        <div class="budget">
                            <h2>Budget 1 Cashflow</h2>
                            <canvas id="chart1"></canvas>
                        </div>
                        <div class="budget">
                            <h2>Budget 2 Cashflow</h2>
                            <canvas id="chart2"></canvas>
                        </div>
                    </div>
                    <div id="diff"></div>
                    <script>
                        function compareBudgets() {
                            var b1 = document.querySelector('[name=budget1]').value;
                            var b2 = document.querySelector('[name=budget2]').value;
                            if (!b1 || !b2) return;
                            // Use GlideAjax to get data
                            var ga = new GlideAjax('BudgetCalculator');
                            ga.addParam('sysparm_name', 'compareBudgets');
                            ga.addParam('sysparm_budget1', b1);
                            ga.addParam('sysparm_budget2', b2);
                            ga.getXMLAnswer(function(response) {
                                var data = JSON.parse(response);
                                document.getElementById('diff').innerHTML = '<h3>' + data.description + '</h3>';
                                // Render charts with sample data; in real, fetch detailed breakdowns
                                renderChart('chart1', [5000, 3000]); // incomes, expenses
                                renderChart('chart2', [5200, 3300]);
                            });
                        }
                        function renderChart(id, data) {
                            var ctx = document.getElementById(id).getContext('2d');
                            new Chart(ctx, {
                                type: 'bar',
                                data: {
                                    labels: ['Income', 'Expenses'],
                                    datasets: [{
                                        label: 'Amount',
                                        data: data,
                                        backgroundColor: ['green', 'red']
                                    }]
                                }
                            });
                        }
                    </script>
                </body>
                </html>
            ]]>
        </html>
        <processing_script>
            // Server-side script if needed
        </processing_script>
        <client_script>
            // Client script
        </client_script>
        <sys_scope>x_467210_rv_app</sys_scope>
        <active>true</active>
    </sys_ui_page>
</record_update></content>

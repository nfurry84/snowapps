<?xml version="1.0" encoding="UTF-8"?>
<record_producer>
  <name>RV Glass Claim Intake</name>
  <table>x_467210_rv_app_glass_claim</table>
  <label>RV Glass Claim Intake</label>
  <display_name>Submit RV Glass Insurance Claim</display_name>
  <category>service_catalog</category>
  <create_on_table>true</create_on_table>
  <default_table_view>false</default_table_view>
  <sys_class_name>sc_cat_item_producer</sys_class_name>
  <workflow>RV Glass Claim Processing Workflow</workflow>
  <description>Submit an insurance claim for RV glass repair or replacement. Provide vehicle details, damage information, and insurance information.</description>
  
  <!-- Sections -->
  <sections>
    <section>
      <name>Contact Information</name>
      <description>Your contact details</description>
      <fields>
        <field>
          <name>contact_name</name>
          <label>Your Name</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Full name</hint>
        </field>
        <field>
          <name>contact_email</name>
          <label>Email Address</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>email</type>
          <hint>Your email for claim updates</hint>
        </field>
        <field>
          <name>contact_phone</name>
          <label>Phone Number</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>phone_number</type>
          <hint>Best phone to reach you</hint>
        </field>
        <field>
          <name>contact_address</name>
          <label>Service Location Address</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Where the RV is located for service</hint>
        </field>
      </fields>
    </section>
    
    <section>
      <name>Vehicle Information</name>
      <description>Details about your Class A RV</description>
      <fields>
        <field>
          <name>vehicle_year</name>
          <label>RV Year</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>integer</type>
          <hint>Year the RV was manufactured</hint>
        </field>
        <field>
          <name>vehicle_make</name>
          <label>RV Make</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Manufacturer (e.g., Winnebago, Fleetwood, Tiffin)</hint>
        </field>
        <field>
          <name>vehicle_model</name>
          <label>RV Model</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Model name or number</hint>
        </field>
        <field>
          <name>vin</name>
          <label>VIN (Vehicle Identification Number)</label>
          <mandatory>false</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>17-character VIN (optional but helpful)</hint>
        </field>
      </fields>
    </section>
    
    <section>
      <name>Damage Information</name>
      <description>Details about the glass damage</description>
      <fields>
        <field>
          <name>glass_type</name>
          <label>Which glass is damaged?</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>choice</type>
          <choice_list>
            <choice value="windshield">Front Windshield</choice>
            <choice value="side_window">Side Window</choice>
            <choice value="rear_window">Rear Window</choice>
            <choice value="roof_window">Roof Window/Skylight</choice>
            <choice value="multi">Multiple windows</choice>
          </choice_list>
        </field>
        <field>
          <name>claim_type</name>
          <label>What needs to be done?</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>choice</type>
          <choice_list>
            <choice value="repair">Repair (fix cracks/chips)</choice>
            <choice value="replacement">Replacement (new glass)</choice>
            <choice value="both">Both repair and replacement</choice>
          </choice_list>
        </field>
        <field>
          <name>damage_description</name>
          <label>Describe the damage</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Details about cracks, chips, or other damage (e.g., 6-inch crack on driver side windshield)</hint>
        </field>
        <field>
          <name>estimated_cost</name>
          <label>Estimated Repair Cost</label>
          <mandatory>false</mandatory>
          <readonly>false</readonly>
          <type>currency</type>
          <hint>Your estimate for the repair/replacement</hint>
        </field>
      </fields>
    </section>
    
    <section>
      <name>Insurance Information</name>
      <description>Your insurance policy details</description>
      <fields>
        <field>
          <name>insurance_provider</name>
          <label>Insurance Provider</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>reference</type>
          <reference_table>x_467210_rv_app_insurance_provider</reference_table>
          <hint>Select your insurance company</hint>
        </field>
        <field>
          <name>policy_number</name>
          <label>Policy Number</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Your policy number from insurance card</hint>
        </field>
        <field>
          <name>plan_name</name>
          <label>Plan Name</label>
          <mandatory>false</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Name of your specific plan if applicable</hint>
        </field>
        <field>
          <name>deductible_amount</name>
          <label>Deductible Amount</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>currency</type>
          <hint>Amount you must pay before insurance covers the rest</hint>
        </field>
      </fields>
    </section>
    
    <section>
      <name>Payment Information</name>
      <description>How to pay your deductible (DISABLED IN PDI TEST ENVIRONMENT)</description>
      <fields>
        <field>
          <name>payment_method</name>
          <label>Payment Method</label>
          <mandatory>true</mandatory>
          <readonly>false</readonly>
          <type>choice</type>
          <choice_list>
            <choice value="credit_card">Credit Card (Visa, MasterCard, Amex)</choice>
            <choice value="debit_card">Debit Card</choice>
            <choice value="invoice">Invoice Me</choice>
          </choice_list>
          <hint>Select your preferred payment method</hint>
        </field>
        <field>
          <name>card_last_four</name>
          <label>Card Last 4 Digits</label>
          <mandatory>false</mandatory>
          <readonly>false</readonly>
          <type>string</type>
          <hint>Last 4 digits of your card (e.g., 4242) - No full card data stored</hint>
          <condition_field>payment_method</condition_field>
          <condition_value>credit_card,debit_card</condition_value>
        </field>
      </fields>
    </section>
    
    <section>
      <name>Additional Information</name>
      <description>Any other details about your claim</description>
      <fields>
        <field>
          <name>comments</name>
          <label>Additional Comments</label>
          <mandatory>false</mandatory>
          <readonly>false</readonly>
          <type>text</type>
          <hint>Any other information that might help with your claim</hint>
        </field>
      </fields>
    </section>
  </sections>
  
  <!-- Business Rules -->
  <business_rules>
    <rule>
      <name>Process Glass Claim On Creation</name>
      <when>insert</when>
      <script>
        var processor = new GlassClaimProcessor();
        processor.processClaim(current);
      </script>
    </rule>
  </business_rules>
  
  <!-- Display Rules -->
  <display_rules>
    <rule>
      <name>Show deductible calculation</name>
      <field>insurance_covers</field>
      <condition>estimated_cost > 0</condition>
    </rule>
  </display_rules>
</record_producer>

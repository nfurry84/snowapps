<?xml version="1.0" encoding="UTF-8"?>
<record_update table="sc_cat_item">
    <sc_cat_item action="INSERT_OR_UPDATE">
        <sys_id>budget_wizard_rp_sys_id</sys_id>
        <name>Household Budget Wizard</name>
        <short_description>Create and manage household budgets with incomes and expenses</short_description>
        <table>x_467210_household_budget</table>
        <type>record_producer</type>
        <sys_scope>x_467210_rv_app</sys_scope>
        <active>true</active>
        <script>
            // Producer script
            current.user = gs.getUserID();
            current.created_on = gs.nowDateTime();
            current.status = 'draft';
            current.version = 1;
            // Insert incomes and expenses from variables
            var incomes = producer.incomes; // JSON from variable
            if (incomes) {
                var incomeList = JSON.parse(incomes);
                for (var i = 0; i &lt; incomeList.length; i++) {
                    var inc = new GlideRecord('x_467210_income_source');
                    inc.budget = current.sys_id;
                    inc.name = incomeList[i].name;
                    inc.amount = incomeList[i].amount;
                    inc.frequency = incomeList[i].frequency;
                    inc.start_date = incomeList[i].start_date;
                    inc.end_date = incomeList[i].end_date;
                    inc.insert();
                }
            }
            // Similar for expenses and subscriptions
            var expenses = producer.expenses;
            if (expenses) {
                var expenseList = JSON.parse(expenses);
                for (var j = 0; j &lt; expenseList.length; j++) {
                    var exp = new GlideRecord('x_467210_expense');
                    exp.budget = current.sys_id;
                    exp.name = expenseList[j].name;
                    exp.amount = expenseList[j].amount;
                    exp.frequency = expenseList[j].frequency;
                    exp.category = expenseList[j].category;
                    exp.start_date = expenseList[j].start_date;
                    exp.end_date = expenseList[j].end_date;
                    exp.insert();
                }
            }
            // For subscriptions, check if auto_renew etc.
        </script>
    </sc_cat_item>
</record_update></content>
